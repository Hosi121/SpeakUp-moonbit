HOST=127.0.0.1
PORT=8081
DATABASE_URL=mysql://speakup:speakup-local-only@127.0.0.1:3308/speakup_moonbit
PUBLIC_ORIGIN=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local development only. Seeded accounts: alice@example.test / bob@example.test
# Password: speakup-local-only. Production must use AUTH_MODE=supabase.
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional compatible API endpoint (also used by local HTTP fixture tests).
# OPENAI_BASE_URL=https://api.openai.com/v1
TURN_URLS=
TURN_SECRET=

# Native MySQL: when set, require TLS and verify the server certificate.
MYSQL_SSL_CA=
