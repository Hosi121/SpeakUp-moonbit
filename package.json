{
  "name": "speakup-moonbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "imports": {
    "#speakup/browser": "./frontend/src/services/browser.ts",
    "#speakup/host": "./server/host.ts",
    "#js-boundary/host": "./examples/js-boundary/host.mjs"
  },
  "scripts": {
    "moon": "node scripts/moon.mjs",
    "generate": "node scripts/generate.mjs",
    "build:core": "node scripts/build.mjs",
    "build": "npm run build:core && npm run build:native && npm --prefix frontend run build",
    "start": "node scripts/start-native.mjs",
    "dev": "npm run build:core && npm run build:native && node scripts/dev.mjs",
    "check": "npm run build:core && tsc --noEmit && npm --prefix frontend run build && node scripts/check-boundaries.mjs",
    "test": "npm run build:core && npm run moon -- test --target js && node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs tests/features.test.mjs",
    "bench": "node bench/run.mjs",
    "fixtures": "node scripts/capture.mjs && node scripts/capture-message.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env server/seed.ts",
    "test:native": "node scripts/test-native.mjs",
    "test:browser": "playwright test --global-timeout=120000",
    "build:native": "node scripts/build-native.mjs",
    "start:native": "node scripts/start-native.mjs",
    "test:integration:native": "SERVER_RUNTIME=native node --test tests/integration.test.mjs tests/features.test.mjs",
    "test:browser:native": "SERVER_RUNTIME=native playwright test --global-timeout=120000",
    "test:navigation": "npm --prefix frontend run build && npm --prefix frontend run build:message-views && playwright test --config playwright.navigation.config.mjs --global-timeout=120000",
    "start:node": "node --env-file-if-exists=.env server/main.ts",
    "test:boundaries": "node scripts/test-boundaries.mjs"
  },
  "dependencies": {
    "jose": "6.2.12",
    "mysql2": "3.24.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@mizchi/ts": "0.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
