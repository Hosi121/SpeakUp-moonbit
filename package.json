{
  "name": "speakup-moonbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "imports": {
    "#speakup/host": "./server/host.ts"
  },
  "scripts": {
    "moon": "node scripts/moon.mjs",
    "generate": "node scripts/generate.mjs",
    "build:core": "node scripts/build.mjs",
    "build": "npm run build:core && npm --prefix frontend run build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "dev": "npm run build:core && node scripts/dev.mjs",
    "check": "npm run build:core && tsc --noEmit && npm --prefix frontend run build && node scripts/check-boundaries.mjs",
    "test": "npm run build:core && npm run moon -- test && node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "bench": "node bench/run.mjs",
    "fixtures": "node scripts/capture.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env server/seed.ts",
    "test:native": "node scripts/moon.mjs test --target native core/shared core/signaling core/matching",
    "test:browser": "playwright test --global-timeout=120000"
  },
  "dependencies": {
    "jose": "6.2.12",
    "mysql2": "3.24.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@mizchi/ts": "0.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
