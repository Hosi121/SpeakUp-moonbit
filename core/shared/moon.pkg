        "decode_inbox:parseInbox",
        "decode_thread:parseThread",
        "decode_stats:parseStats",
        "decode_events:parseEvents",
        "decode_roster:parseRoster",
        "decode_learning:parseLearning",
        "decode_profile_response:parseProfile",
        "decode_users_response:parseUsers",
