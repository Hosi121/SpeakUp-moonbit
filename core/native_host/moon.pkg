import {
  "hosi121/speakup/identity",
  "hosi121/speakup/api",
  "moonbitlang/async",
  "Hosi121/mysql",
  "Hosi121/sql_session" @sql,
  "hosi121/speakup/wire",
  "moonbitlang/async/http",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
}

supported_targets = "native"

options(
  "native-stub": [ "host.c" ],
  link: { "native": { "cc-link-flags": "-lmariadb -lcrypto -lpthread" } },
)
